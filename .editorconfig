# Shared with .gitattributes: LF everywhere, so a Windows editor cannot
# reintroduce the CRLF that makes gofmt rewrite a whole file.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
