# Local development config — copy to .env (gitignored) and adjust.
# The binary loads this file at startup; real env vars take precedence.
# In production, setup.sh generates /opt/quasar/.env instead.

DOMAIN=localhost
LISTEN_ADDR=:8080

# Relative paths are resolved from the project root at startup.
DB_PATH=.dev/database.sqlite
APPS_DIR=.dev/apps
BACKUPS_DIR=.dev/backups

# First-boot admin account (only used while the users table is empty).
ADMIN_USER=admin
ADMIN_PASSWORD=password123

# Disk gauge root: "/" on Linux, a drive like C:\ on Windows.
HOST_ROOT=C:\

# Allow the session cookie over plain HTTP (dev only — never in production).
COOKIE_SECURE=false
