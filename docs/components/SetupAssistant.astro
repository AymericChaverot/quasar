---
/**
 * The install page, with the reader's own domain in it.
 *
 * Everything here is already written on /getting-started/installation/; what
 * this adds is that the commands can be copied rather than adapted, which is
 * where a domain typed slightly differently in two of them turns into a
 * certificate that never arrives.
 *
 * Nothing is sent anywhere: the answers only ever reach the page.
 */
---

<div class="sa" data-setup-assistant>
  <noscript>
    <p class="sa-note">This tool needs JavaScript. The <a href="../../getting-started/installation/">installation page</a> has the same steps, with placeholders to replace.</p>
  </noscript>
  <div data-app></div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-setup-assistant]')!;
  const app = root.querySelector<HTMLElement>('[data-app]')!;

  const STORAGE_KEY = 'quasar-setup-assistant';

  const state = { domain: '', ip: '', email: '' };
  try {
    Object.assign(state, JSON.parse(localStorage.getItem(STORAGE_KEY) ?? '{}'));
  } catch {
    /* private window: the page still works, it just forgets */
  }

  const esc = (s: string) =>
    String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  /** A domain is only usable once it looks like one; until then the commands keep the placeholder. */
  const domainRe = /^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$/i;
  const ipRe = /^(\d{1,3}\.){3}\d{1,3}$|^[0-9a-f:]{3,}$/i;

  const domain = () => (domainRe.test(state.domain.trim()) ? state.domain.trim().toLowerCase() : 'your-domain.com');
  const ip = () => (ipRe.test(state.ip.trim()) ? state.ip.trim() : 'YOUR.VPS.IP');
  const email = () => (state.email.trim() ? state.email.trim() : 'you@example.com');

  function block(title: string, note: string, code: string, lang = '') {
    return `<figure class="sa-block">
      <figcaption>
        <span>${esc(title)}</span>
        <button type="button" class="sa-copy" data-copy="${esc(code)}">Copy</button>
      </figcaption>
      <pre class="sa-code ${lang}"><code>${esc(code)}</code></pre>
      ${note ? `<p class="sa-help">${note}</p>` : ''}
    </figure>`;
  }

  function render() {
    const d = domain();
    const known = d !== 'your-domain.com';

    app.innerHTML = `
      <div class="sa-form">
        <label class="sa-field">
          <span class="sa-label">Your domain</span>
          <input class="sa-input sa-mono" data-bind="domain" value="${esc(state.domain)}" placeholder="example.com" autocomplete="off" spellcheck="false">
        </label>
        <label class="sa-field">
          <span class="sa-label">The VPS address</span>
          <input class="sa-input sa-mono" data-bind="ip" value="${esc(state.ip)}" placeholder="203.0.113.10" autocomplete="off" spellcheck="false">
        </label>
        <label class="sa-field">
          <span class="sa-label">Email for Let's Encrypt</span>
          <input class="sa-input sa-mono" data-bind="email" value="${esc(state.email)}" placeholder="you@example.com" autocomplete="off" spellcheck="false">
        </label>
      </div>
      ${known ? '' : '<p class="sa-note">Fill in the two fields above and the commands below become yours to copy. Until then they carry placeholders.</p>'}

      <ol class="sa-steps">
        <li>
          <h3 class="sa-h">1. Point the DNS at the server</h3>
          <p class="sa-help">Two records, at your registrar. Both are needed: the wildcard covers <span class="sa-mono">admin.</span> and every application, but not ${esc(d)} itself.</p>
          ${block('DNS records', 'Do this before installing: Let\'s Encrypt only issues a certificate once the name resolves to the server.', `A     ${d}      ${ip()}\nA     *.${d}    ${ip()}`)}
          <p class="sa-help">Delete any record the registrar left on ${esc(d)} beside yours — an apex pointing at their shared hosting is the most common reason issuance fails.</p>
        </li>
        <li>
          <h3 class="sa-h">2. Open the ports</h3>
          ${block('On the VPS, as root', 'Port 80 is not optional: the certificate is validated over it.', 'ufw allow 22/tcp && ufw allow 80/tcp && ufw allow 443/tcp && ufw enable')}
        </li>
        <li>
          <h3 class="sa-h">3. Check the DNS before you install</h3>
          ${block('From anywhere', 'Both should answer with ' + esc(ip()) + '. A wrong answer here is a certificate that will not arrive.', `dig +short ${d}\ndig +short admin.${d}`)}
        </li>
        <li>
          <h3 class="sa-h">4. Install</h3>
          ${block('On the VPS, as root', 'It installs Docker if needed, then asks four questions: the root domain, the Let\'s Encrypt email, and the first admin account.', 'curl -sSL https://raw.githubusercontent.com/AymericChaverot/quasar/main/setup.sh | sudo bash')}
          <div class="sa-answers">
            <p class="sa-answers-head">What it will ask</p>
            <dl>
              <div><dt>Root domain</dt><dd class="sa-mono">${esc(d)}</dd></div>
              <div><dt>Let's Encrypt email</dt><dd class="sa-mono">${esc(email())}</dd></div>
              <div><dt>Admin username</dt><dd>yours to choose</dd></div>
              <div><dt>Admin password</dt><dd>8 characters at least, removed from the server's <span class="sa-mono">.env</span> once the account exists</dd></div>
            </dl>
          </div>
        </li>
        <li>
          <h3 class="sa-h">5. Sign in</h3>
          <p class="sa-help">The first load can take a few seconds while the certificate is issued.</p>
          ${block('In a browser', '', `https://admin.${d}`)}
          ${block('Or from a terminal', 'A 200 means the dashboard is up and its certificate is valid.', `curl -sSI https://admin.${d} | head -n 1`)}
        </li>
      </ol>

      <p class="sa-help">Next: <a href="../../getting-started/first-steps/">the first settings worth having</a> — two-factor authentication, notifications, backups and the master key.</p>`;
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    } catch {
      /* nothing to do: the page works without remembering */
    }
  }

  app.addEventListener('input', (event) => {
    const el = event.target as HTMLInputElement;
    const key = el.dataset.bind as keyof typeof state;
    if (!key) return;
    state[key] = el.value;
    const at = el.selectionStart;
    render();
    const again = app.querySelector<HTMLInputElement>(`[data-bind="${key}"]`);
    again?.focus();
    if (again && at != null) again.setSelectionRange(at, at);
  });

  app.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-copy]');
    if (!button) return;
    const label = button.textContent;
    try {
      await navigator.clipboard.writeText(button.dataset.copy ?? '');
      button.textContent = 'Copied';
    } catch {
      button.textContent = 'Copy failed';
    }
    setTimeout(() => (button.textContent = label), 1500);
  });

  render();
</script>

<style is:global>
  .sa {
    margin-block: 1.5rem;
  }

  .sa-form {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 0.75rem;
    padding: 1rem;
    border: var(--border-width, 1px) solid var(--border);
    border-radius: var(--radius-main, 0.75rem);
    background: var(--background-2);
  }

  .sa-field {
    display: grid;
    gap: 0.25rem;
  }

  .sa-label {
    color: var(--text-2);
    font-size: 0.8125rem;
  }

  .sa-input {
    width: 100%;
    padding: 0.375rem 0.5rem;
    border: var(--border-width, 1px) solid var(--border);
    border-radius: 0.375rem;
    background: var(--background);
    color: var(--text);
    font: inherit;
    font-size: 0.875rem;
  }

  .sa-input:focus {
    outline: 2px solid var(--accent);
    outline-offset: -1px;
  }

  .sa-mono {
    font-family: var(--mono-family, monospace);
  }

  .sa-note,
  .sa-help {
    color: var(--text-2);
    font-size: 0.8125rem;
  }

  .sa-steps {
    display: grid;
    gap: 1.25rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }

  .sa-steps > li {
    display: grid;
    gap: 0.5rem;
  }

  .sa .sa-h {
    margin: 0;
    padding: 0;
    border: 0;
    font-size: 1rem;
  }

  .sa-block {
    margin: 0;
    border: var(--border-width, 1px) solid var(--border);
    border-radius: 0.5rem;
    overflow: hidden;
  }

  .sa-block figcaption {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    justify-content: space-between;
    padding: 0.375rem 0.625rem;
    border-bottom: var(--border-width, 1px) solid var(--border);
    background: var(--background-2);
    color: var(--text-2);
    font-size: 0.75rem;
  }

  .sa-copy {
    padding: 0.125rem 0.625rem;
    border: var(--border-width, 1px) solid var(--border);
    border-radius: 999px;
    background: var(--background);
    color: var(--text);
    font-size: 0.75rem;
    cursor: pointer;
  }

  .sa-copy:hover {
    border-color: var(--accent);
  }

  .sa-code {
    margin: 0;
    padding: 0.75rem;
    overflow-x: auto;
    background: var(--background);
    font-family: var(--mono-family, monospace);
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  .sa-block .sa-help {
    margin: 0;
    padding: 0.5rem 0.625rem;
    border-top: var(--border-width, 1px) solid var(--border);
    background: var(--background-2);
    font-size: 0.75rem;
  }

  .sa-answers {
    padding: 0.75rem;
    border: var(--border-width, 1px) solid var(--border);
    border-radius: 0.5rem;
    background: var(--background-2);
  }

  .sa-answers-head {
    margin: 0 0 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .sa-answers dl {
    display: grid;
    gap: 0.25rem;
    margin: 0;
  }

  .sa-answers dl > div {
    display: grid;
    grid-template-columns: minmax(9rem, auto) 1fr;
    gap: 0.75rem;
    font-size: 0.8125rem;
  }

  .sa-answers dt {
    color: var(--text-2);
  }

  .sa-answers dd {
    margin: 0;
  }
</style>
